.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #EAEAEA;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
}

.tab-text {
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 500;
}
