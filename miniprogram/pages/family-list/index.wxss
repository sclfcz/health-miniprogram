/* 家属列表页样式 */
.container {
  padding: 30rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  padding: 20rpx 0 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
}

.list-container {
  padding-bottom: 150rpx;
}

.family-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  overflow: hidden;
  transition: all 0.2s;
}

.family-card:active {
  transform: scale(0.98);
}

.card-main {
  display: flex;
  align-items: center;
  padding: 30rpx;
  position: relative;
}

.card-actions-right {
  margin-right: 16rpx;
}

.edit-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s;
}

.edit-btn:active {
  background: rgba(0, 0, 0, 0.05);
}

.edit-icon-svg {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.7;
}

/* CSS 编辑图标（铅笔形状） */
.icon-edit {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  opacity: 0.7;
}

.icon-edit::before {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #666666;
  border-radius: 4rpx;
  transform: rotate(-45deg);
  left: 6rpx;
  top: 0;
}

.icon-edit::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #666666;
  left: 8rpx;
  bottom: 2rpx;
  transform: rotate(-45deg);
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, #C8E6C9 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.relation-tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 6rpx;
  align-self: flex-start;
}

.relation {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.phone {
  font-size: 26rpx;
  color: var(--text-hint);
}

.notes {
  font-size: 24rpx;
  color: var(--text-disabled);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: var(--border-color);
  color: var(--text-hint);
}

.status.active {
  background: var(--primary-light);
  color: var(--primary-color);
}

.card-footer {
  display: flex;
  border-top: 1rpx solid var(--border-color);
}

.card-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #F8F9FA;
  transition: background 0.2s;
}

.card-action:active {
  background: var(--border-color);
}

.delete-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  background: #FFEBEE;
  transition: background 0.2s;
}

.delete-action:active {
  background: #FFCDD2;
}

.delete-text {
  font-size: 28rpx;
  color: #E53935;
  font-weight: 500;
}

.card-action.calling {
  background: var(--primary-light);
}

.card-action.calling .call-icon {
  animation: pulse 0.5s ease-in-out infinite;
}

.card-action.calling .call-text {
  color: var(--primary-color);
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.2);
    opacity: 0.8;
  }
}

.call-icon-svg {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

/* CSS 电话图标 */
.icon-phone {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  position: relative;
}

.icon-phone::before {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 12rpx;
  border: 4rpx solid #07C160;
  border-radius: 10rpx 10rpx 0 0;
  border-bottom: none;
  top: 0;
  left: 0;
  transform: rotate(-30deg);
}

.icon-phone::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 12rpx;
  border: 4rpx solid #07C160;
  border-radius: 0 0 10rpx 10rpx;
  border-top: none;
  bottom: 0;
  right: 0;
  transform: rotate(-30deg);
}

.call-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.call-text {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  animation: fadeIn 0.5s ease-out;
}

.empty-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-icon-svg {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.8;
}

/* CSS 家庭空状态图标 */
.icon-family-empty {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.icon-family-empty .person {
  background: #CCCCCC;
  border-radius: 50%;
}

.icon-family-empty .person-1 {
  width: 32rpx;
  height: 32rpx;
}

.icon-family-empty .person-2 {
  width: 40rpx;
  height: 40rpx;
}

.icon-family-empty .person-3 {
  width: 32rpx;
  height: 32rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-disabled);
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 12rpx 36rpx rgba(7, 193, 96, 0.4),
    0 4rpx 12rpx rgba(7, 193, 96, 0.2);
  z-index: 100;
  transition: all 0.2s;
}

.fab-btn:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}
