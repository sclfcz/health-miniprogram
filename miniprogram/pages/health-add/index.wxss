.container {
  padding: 30rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 180rpx;
}

.card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-item {
  display: flex;
  flex-direction: column;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.input-row {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.input-field {
  flex: 1;
  height: 88rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
}

.picker-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 24rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #666;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.btn-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.save-btn {
  width: 100%;
  height: 100rpx;
  background: #4CAF50;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
}

.save-btn:active {
  transform: scale(0.96);
}

.save-btn::after {
  border: none;
}
