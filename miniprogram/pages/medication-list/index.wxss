/* 用药列表页样式 */
.container {
  padding: 30rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  padding: 20rpx 0 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
}

.date {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
  display: block;
}

.list-container {
  padding-bottom: 150rpx;
}

.med-card {
  background: var(--card-bg);
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  transition: all 0.2s;
  position: relative;
}

/* 状态标签 */
.status-tag {
  position: absolute;
  top: 0;
  left: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
  font-size: 22rpx;
  color: #FFFFFF;
}

.status-tag.status-pending {
  background: #2196F3;
}

.status-tag.status-taken {
  background: #07C160;
}

.status-tag.status-missed {
  background: #E53935;
}

.status-tag.status-supplement {
  background: #FF9800;
}

.delete-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
  z-index: 10;
}

.delete-btn:active {
  background: rgba(229, 57, 53, 0.1);
  transform: scale(0.9);
}

.delete-icon-svg {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.delete-btn-text {
  font-size: 24rpx;
  color: #A66A6A;
  font-weight: 600;
  line-height: 1;
}

.med-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.med-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, #C8E6C9 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-text {
  font-size: 40rpx;
}

.icon-svg {
  width: 44rpx;
  height: 44rpx;
}

/* CSS 小药丸图标 */
.icon-pill-small {
  width: 32rpx;
  height: 16rpx;
  background: linear-gradient(90deg, #07C160 50%, #FFFFFF 50%);
  border-radius: 16rpx;
  border: 2rpx solid #FFFFFF;
  box-sizing: border-box;
}

/* CSS 空状态列表图标 */
.icon-list-empty {
  width: 60rpx;
  height: 70rpx;
  background: #CCCCCC;
  border-radius: 8rpx;
  position: relative;
}

.icon-list-empty::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 10rpx;
  right: 10rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 3rpx;
}

.icon-list-empty::after {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 10rpx;
  right: 10rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 3rpx;
}

.med-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.med-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.med-remark {
  font-size: 24rpx;
  color: var(--text-hint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.med-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* 操作区域 */
.action-area {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.take-btn {
  background: var(--primary-color);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
}

.take-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.take-btn:active {
  opacity: 0.8;
}

.taken-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.taken-info text {
  font-size: 24rpx;
  color: #07C160;
}

.supplement-btn {
  background: #FF9800;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
}

.supplement-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.supplement-btn:active {
  opacity: 0.8;
}

.supplement-info {
  padding: 16rpx 32rpx;
  background: #FFF3E0;
  border-radius: 32rpx;
}

.supplement-info text {
  font-size: 26rpx;
  color: #FF9800;
}

.dosage-tag {
  background: var(--primary-light);
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.dosage-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  animation: fadeIn 0.5s ease-out;
}

.empty-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-icon-svg {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.8;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-disabled);
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 12rpx 36rpx rgba(7, 193, 96, 0.4),
    0 4rpx 12rpx rgba(7, 193, 96, 0.2);
  z-index: 100;
  transition: all 0.2s;
}

.fab-btn:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}
