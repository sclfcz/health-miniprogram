.container {
  padding: 30rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 月报头部 */
.report-header {
  text-align: center;
  padding: 40rpx 0;
}

.report-title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.report-subtitle {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 依从性卡片 */
.compliance-card {
  background: linear-gradient(135deg, #07C160 0%, #4CAF50 100%);
  border-radius: 24rpx;
  padding: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(7, 193, 96, 0.3);
}

.compliance-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.compliance-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.compliance-unit {
  font-size: 32rpx;
  color: #FFFFFF;
  margin-left: 4rpx;
}

.compliance-label {
  font-size: 32rpx;
  color: #FFFFFF;
}

/* 评估卡片 */
.evaluation-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.evaluation-header {
  margin-bottom: 20rpx;
}

.evaluation-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.evaluation-content {
  margin-bottom: 20rpx;
}

.evaluation-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.evaluation-level {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.evaluation-level.level-excellent {
  background: #E8F5E9;
  color: #07C160;
}

.evaluation-level.level-good {
  background: #E3F2FD;
  color: #2196F3;
}

.evaluation-level.level-normal {
  background: #FFF3E0;
  color: #FF9800;
}

.evaluation-level.level-poor {
  background: #FFEBEE;
  color: #E53935;
}

.evaluation-level.level-none {
  background: #F5F5F5;
  color: #999999;
}

/* 统计卡片 */
.stats-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  display: block;
  margin-bottom: 24rpx;
}

.stats-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stats-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.stats-item:last-child {
  border-bottom: none;
}

.stats-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.stats-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.stats-value.missed {
  color: #E53935;
}

.stats-value.supplement {
  color: #FF9800;
}

/* 每日记录卡片 */
.daily-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.daily-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.daily-item {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--bg-color);
}

.daily-item.empty {
  opacity: 0.4;
}

.daily-item.status-taken {
  background: #E8F5E9;
}

.daily-item.status-taken .daily-dot {
  background: #07C160;
}

.daily-item.status-missed {
  background: #FFEBEE;
}

.daily-item.status-missed .daily-dot {
  background: #E53935;
}

.daily-item.status-supplement {
  background: #FFF3E0;
}

.daily-item.status-supplement .daily-dot {
  background: #FF9800;
}

.daily-day {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.daily-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #CCCCCC;
  margin-top: 4rpx;
}

.daily-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-item text {
  font-size: 24rpx;
  color: var(--text-hint);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.taken {
  background: #07C160;
}

.legend-dot.missed {
  background: #E53935;
}

.legend-dot.supplement {
  background: #FF9800;
}

/* 建议卡片 */
.advice-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.advice-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}
