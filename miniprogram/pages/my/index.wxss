/* 个人中心样式 */
.container {
  min-height: 100vh;
  background: transparent;
}

.user-header {
  background: linear-gradient(135deg, var(--primary-light) 0%, #C8E6C9 100%);
  padding: 60rpx 30rpx 50rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.user-text {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.edit-hint {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-top: 8rpx;
}

.user-info:active {
  opacity: 0.8;
}

/* 患者ID展示区域 */
.id-section {
  margin-top: 30rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}

.id-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.id-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.id-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  font-family: monospace;
  word-break: break-all;
  background: rgba(255, 255, 255, 0.8);
  padding: 16rpx;
  border-radius: 8rpx;
}

.copy-btn {
  padding: 16rpx 24rpx;
  background: var(--primary-color);
  border-radius: 8rpx;
}

.copy-btn text {
  font-size: 24rpx;
  color: #fff;
}

.copy-btn:active {
  opacity: 0.8;
}

.id-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

.menu-section {
  margin: 24rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F8F9FA;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon-img {
  width: 40rpx;
  height: 40rpx;
}

/* CSS 报告图标 */
.icon-report {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 28rpx;
}

.icon-report .chart-bar {
  width: 8rpx;
  border-radius: 4rpx;
  background: #07C160;
}

.icon-report .bar-1 {
  height: 16rpx;
}

.icon-report .bar-2 {
  height: 24rpx;
}

.icon-report .bar-3 {
  height: 20rpx;
}

/* CSS 书籍图标 */
.icon-book {
  width: 28rpx;
  height: 32rpx;
  background: #07C160;
  border-radius: 4rpx;
  position: relative;
}

.icon-book::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 4rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

/* CSS 家庭图标 */
.icon-family {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
}

.icon-family .head {
  background: #07C160;
  border-radius: 50%;
}

.icon-family .head-1 {
  width: 20rpx;
  height: 20rpx;
}

.icon-family .head-2 {
  width: 16rpx;
  height: 16rpx;
}

/* CSS 退出登录图标 */
.icon-logout {
  width: 32rpx;
  height: 28rpx;
  position: relative;
}

.icon-logout .door {
  width: 20rpx;
  height: 28rpx;
  border: 4rpx solid #666666;
  border-radius: 4rpx;
  position: absolute;
  left: 0;
  top: 0;
}

.icon-logout .arrow {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 10rpx solid #666666;
  position: absolute;
  right: 0;
  top: 6rpx;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-disabled);
}

.version {
  text-align: center;
  padding: 60rpx 0;
}

.version text {
  font-size: 24rpx;
  color: var(--text-disabled);
}

/* 消息中心图标 */
.icon-message {
  width: 32rpx;
  height: 28rpx;
  position: relative;
}

.icon-message .bell {
  width: 24rpx;
  height: 20rpx;
  border: 4rpx solid #07C160;
  border-radius: 12rpx 12rpx 0 0;
  position: absolute;
  top: 0;
  left: 4rpx;
}

.icon-message .bell::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  margin-left: -6rpx;
  width: 12rpx;
  height: 4rpx;
  background: #07C160;
  border-radius: 2rpx;
}

.icon-message .dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 12rpx;
  height: 12rpx;
  background: #E53935;
  border-radius: 50%;
}

/* 绑定图标 */
.icon-link {
  width: 32rpx;
  height: 16rpx;
  position: relative;
}

.icon-link::before,
.icon-link::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid #07C160;
  border-radius: 50%;
  top: 0;
}

.icon-link::before {
  left: 0;
}

.icon-link::after {
  right: 0;
}

/* 菜单数量角标 */
.menu-badge {
  margin-left: 16rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #E53935;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}

.menu-badge text {
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
}

.menu-badge.pending {
  background: #FF9800;
}

/* 家属端绑定患者ID输入框 */
.family-bind {
  background: rgba(255, 255, 255, 0.8);
}

.bind-input-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bind-input {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.bind-input::placeholder {
  color: var(--text-hint);
}

.bind-btn {
  padding: 0 32rpx;
  height: 72rpx;
  background: #BDBDBD;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-btn.active {
  background: #2196F3;
}

.bind-btn text {
  font-size: 26rpx;
  color: #fff;
  white-space: nowrap;
}

.bind-btn:active {
  opacity: 0.8;
}
