/* 健康记录列表页样式 */
.container {
  padding: 30rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  padding: 20rpx 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
}

.analysis-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--primary-light);
  border-radius: 32rpx;
}

.analysis-btn text {
  font-size: 24rpx;
  color: var(--primary-color);
}

.list-container {
  padding-bottom: 150rpx;
}

.data-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  overflow: hidden;
  transition: all 0.2s;
}

.data-card:active {
  transform: scale(0.98);
}

.card-header {
  background: #F8F9FA;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-wrapper {
  display: flex;
  align-items: center;
}

.measure-time {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

.delete-link {
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 8rpx 16rpx;
}

.delete-link:active {
  color: var(--warning-color);
}

.card-body {
  padding: 24rpx 30rpx;
}

.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.data-row:first-child {
  padding-top: 0;
}

.data-row:last-child {
  padding-bottom: 0;
}

.data-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.data-value {
  font-size: 36rpx;
  font-weight: bold;
  font-variant-numeric: tabular-nums;
}

.data-value.normal {
  color: var(--primary-color);
}

.data-value.warning {
  color: var(--warning-color);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  animation: fadeIn 0.5s ease-out;
}

.empty-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-icon-svg {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.8;
}

/* CSS 空状态图表图标 */
.icon-chart-empty {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 60rpx;
}

.icon-chart-empty .bar {
  width: 14rpx;
  border-radius: 6rpx;
  background: #CCCCCC;
}

.icon-chart-empty .bar-1 {
  height: 30rpx;
}

.icon-chart-empty .bar-2 {
  height: 50rpx;
}

.icon-chart-empty .bar-3 {
  height: 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-disabled);
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 12rpx 36rpx rgba(7, 193, 96, 0.4),
    0 4rpx 12rpx rgba(7, 193, 96, 0.2);
  z-index: 100;
  transition: all 0.2s;
}

.fab-btn:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}
