<view class="container">
  <view class="header">
    <text class="title">选择患者</text>
    <text class="subtitle">请选择要查看的患者</text>
  </view>

  <view class="list" wx:if="{{patientList.length > 0}}">
    <view class="patient-item" wx:for="{{patientList}}" wx:key="_id" bindtap="selectPatient" data-openid="{{item.patientOpenid}}" data-name="{{item.patientName}}">
      <view class="patient-avatar">
        <text>{{item.patientName.substring(0,1)}}</text>
      </view>
      <view class="patient-info">
        <text class="patient-name">{{item.patientName}}</text>
        <text class="patient-relation">{{item.relation}}</text>
      </view>
      <text class="select-arrow">›</text>
    </view>
  </view>

  <view class="empty" wx:if="{{patientList.length === 0 && !loading}}">
    <view class="empty-icon">
      <view class="empty-person"></view>
    </view>
    <text class="empty-title">暂无关联患者</text>
    <text class="empty-desc">请先绑定患者后再查看</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
