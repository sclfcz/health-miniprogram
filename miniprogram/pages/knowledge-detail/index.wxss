.container {
  padding: 30rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

.article-header {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
  display: block;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.article-tag {
  font-size: 24rpx;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.article-time {
  font-size: 24rpx;
  color: var(--text-hint);
}

.article-content {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.content-text {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.8;
  white-space: pre-wrap;
}
