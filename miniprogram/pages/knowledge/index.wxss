.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  background: transparent;
  box-sizing: border-box;
}

.search-bar {
  margin-bottom: 24rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 40rpx;
  padding: 22rpx 28rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.06),
    0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.search-input {
  flex: 1;
  margin: 0 16rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.article-card {
  display: flex;
  gap: 20rpx;
  padding: 22rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.06),
    0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.cover-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: #E8F5E9;
}

.article-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.article-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  justify-content: center;
  flex-shrink: 0;
}

.action-btn {
  min-width: 96rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  text-align: center;
  border: 1rpx solid transparent;
}

.action-btn text {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.edit-btn {
  background: rgba(76, 175, 80, 0.12);
  border-color: rgba(76, 175, 80, 0.2);
}

.delete-btn {
  background: rgba(229, 57, 53, 0.10);
  border-color: rgba(229, 57, 53, 0.16);
}

.edit-btn text {
  color: #2E7D32;
}

.delete-btn text {
  color: #B23A35;
}

.article-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.article-title {
  font-size: 32rpx;
  line-height: 1.5;
  color: var(--text-primary);
  font-weight: bold;
}

.article-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #168A52;
  background: rgba(7, 193, 96, 0.12);
}

.article-summary {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.loading-state,
.load-status {
  text-align: center;
  padding: 36rpx 0;
}

.loading-state text,
.load-status text {
  font-size: 26rpx;
  color: var(--text-hint);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(7, 193, 96, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.icon-book {
  width: 48rpx;
  height: 58rpx;
  background: #4CAF50;
  border-radius: 6rpx;
  position: relative;
}

.icon-book::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: #FFFFFF;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-hint);
}

.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: 148rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7BC67E 0%, #58A85D 100%);
  box-shadow: 0 10rpx 24rpx rgba(88, 168, 93, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-icon {
  width: 38rpx;
  height: 38rpx;
  position: relative;
}

.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background: #FFFFFF;
  border-radius: 3rpx;
}

.fab-icon::before {
  width: 6rpx;
  height: 38rpx;
  left: 50%;
  margin-left: -3rpx;
}

.fab-icon::after {
  width: 38rpx;
  height: 6rpx;
  top: 50%;
  margin-top: -3rpx;
}
