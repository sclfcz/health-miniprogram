/* 首页样式 */
.container {
  padding: 30rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  padding: 40rpx 0 50rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 紧急呼叫按钮 */
.emergency-section {
  margin-bottom: 30rpx;
}

.emergency-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E53935 0%, #FF5252 100%);
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(229, 57, 53, 0.4);
  transition: all 0.2s;
}

.emergency-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.emergency-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.phone-icon {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 8rpx 8rpx 0 8rpx;
  transform: rotate(-45deg);
}

.emergency-text {
  display: flex;
  flex-direction: column;
}

.emergency-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.emergency-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.menu-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.menu-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  transition: all 0.2s;
}

.menu-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.menu-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, #C8E6C9 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.icon-svg {
  width: 48rpx;
  height: 48rpx;
}

/* CSS 药丸图标 */
.icon-pill {
  width: 36rpx;
  height: 18rpx;
  background: linear-gradient(90deg, #07C160 50%, #FFFFFF 50%);
  border-radius: 18rpx;
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

/* CSS 图表图标 */
.icon-chart {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 32rpx;
}

.icon-chart .bar {
  width: 8rpx;
  border-radius: 4rpx;
  background: #FFFFFF;
}

.icon-chart .bar-1 {
  height: 16rpx;
}

.icon-chart .bar-2 {
  height: 28rpx;
}

.icon-chart .bar-3 {
  height: 22rpx;
}

.menu-info {
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: var(--text-hint);
}

.section {
  margin-top: 20rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.data-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.data-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.data-item:last-of-type {
  border-bottom: none;
}

.data-label {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.data-value {
  font-size: 36rpx;
  font-weight: bold;
  font-variant-numeric: tabular-nums;
}

.data-value.normal {
  color: var(--primary-color);
}

.data-value.warning {
  color: var(--warning-color);
}

.data-time {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.time-text {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
}

.empty-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

.task-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.task-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.task-item:last-child {
  border-bottom: none;
}

.task-time {
  width: 100rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
  flex-shrink: 0;
}

.task-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.task-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.task-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.task-status {
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.task-status.status-pending {
  background: #E3F2FD;
  color: #2196F3;
}

.task-status.status-taken {
  background: #E8F5E9;
  color: #07C160;
}

.task-status.status-missed {
  background: #FFEBEE;
  color: #E53935;
}

.task-status.status-supplement {
  background: #FFF3E0;
  color: #FF9800;
}

/* 消息提醒卡片 */
.message-section {
  margin-bottom: 30rpx;
}

.message-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.3);
  transition: all 0.2s;
}

.message-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.message-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-bell {
  width: 32rpx;
  height: 28rpx;
  border: 4rpx solid #fff;
  border-radius: 16rpx 16rpx 0 0;
  position: relative;
}

.icon-bell::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  margin-left: -6rpx;
  width: 12rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 2rpx;
}

.message-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.message-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 4rpx;
}

.message-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.message-badge {
  min-width: 40rpx;
  height: 40rpx;
  background: #E53935;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  margin-right: 16rpx;
}

.message-badge text {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
}

.message-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 家属端样式 ========== */

/* 绑定患者入口 */
.bind-section {
  margin-bottom: 30rpx;
}

.bind-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2196F3 0%, #64B5F6 100%);
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(33, 150, 243, 0.3);
  transition: all 0.2s;
}

.bind-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.bind-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-link {
  width: 32rpx;
  height: 16rpx;
  position: relative;
}

.icon-link::before,
.icon-link::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  top: 0;
}

.icon-link::before {
  left: 0;
}

.icon-link::after {
  right: 0;
}

.bind-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bind-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 4rpx;
}

.bind-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.bind-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 患者列表 */
.patient-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.patient-card {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.patient-card:active {
  transform: scale(0.98);
}

.patient-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, #C8E6C9 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.patient-avatar text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.patient-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.patient-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.patient-relation {
  font-size: 26rpx;
  color: var(--text-hint);
}

.patient-status {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #4CAF50;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-text {
  font-size: 24rpx;
  color: #4CAF50;
}

/* 空状态 */
.empty-patient {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 60rpx 30rpx;
  text-align: center;
}

.empty-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.icon-person {
  width: 40rpx;
  height: 40rpx;
  background: #ccc;
  border-radius: 50%;
  position: relative;
}

.icon-person::after {
  content: '';
  position: absolute;
  width: 50rpx;
  height: 25rpx;
  background: #ccc;
  border-radius: 25rpx 25rpx 0 0;
  bottom: -30rpx;
  left: 50%;
  margin-left: -25rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-hint);
}
