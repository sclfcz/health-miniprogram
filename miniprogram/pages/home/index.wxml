<view class="container">
  <view class="header">
    <text class="title">康养日记</text>
    <text class="subtitle">{{role === 'patient' ? '记录健康，关爱每一天' : '关爱家人，守护健康'}}</text>
  </view>

  <block wx:if="{{role === 'patient'}}">
    <view class="message-section" wx:if="{{pendingCount > 0}}" bindtap="goToMessageCenter">
      <view class="message-card">
        <view class="message-icon">
          <view class="icon-bell"></view>
        </view>
        <view class="message-content">
          <text class="message-title">您有新的绑定申请</text>
          <text class="message-desc">{{pendingCount}} 位家属请求与您关联</text>
        </view>
        <view class="message-badge">
          <text>{{pendingCount}}</text>
        </view>
        <text class="message-arrow">></text>
      </view>
    </view>

    <view class="emergency-section">
      <view class="emergency-btn" bindtap="onEmergencyCall">
        <view class="emergency-icon">
          <view class="phone-icon"></view>
        </view>
        <view class="emergency-text">
          <text class="emergency-title">紧急呼叫家属</text>
          <text class="emergency-desc">一键拨打家属电话</text>
        </view>
      </view>
    </view>

    <view class="menu-grid">
      <view class="menu-card" bindtap="goToMedication">
        <view class="menu-icon">
          <view class="icon-pill"></view>
        </view>
        <view class="menu-info">
          <text class="menu-title">用药管理</text>
          <text class="menu-desc">提醒准时吃药</text>
        </view>
      </view>

      <view class="menu-card" bindtap="goToHealth">
        <view class="menu-icon">
          <view class="icon-chart">
            <view class="bar bar-1"></view>
            <view class="bar bar-2"></view>
            <view class="bar bar-3"></view>
          </view>
        </view>
        <view class="menu-info">
          <text class="menu-title">健康监测</text>
          <text class="menu-desc">血压血糖记录</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">今日待执行任务</text>
      <view class="task-card" wx:if="{{todayTasks.length > 0}}">
        <view class="task-item" wx:for="{{todayTasks}}" wx:key="id" bindtap="goToMedication">
          <view class="task-time">{{item.scheduled_time}}</view>
          <view class="task-info">
            <text class="task-name">{{item.med_name}}</text>
            <text class="task-meta">{{item.dosage}} | {{item.cycleText}}</text>
          </view>
          <view class="task-status status-{{item.status}}">
            <text>{{item.statusText}}</text>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-text">今天暂无服药任务</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">上次测量数据</text>
      <view class="data-card" wx:if="{{latestData}}">
        <view class="data-item">
          <text class="data-label">血压</text>
          <text class="data-value {{latestData.systolic > 140 || latestData.diastolic > 90 ? 'warning' : 'normal'}}">
            {{latestData.systolic}}/{{latestData.diastolic}} mmHg
          </text>
        </view>
        <view class="data-item">
          <text class="data-label">血糖</text>
          <text class="data-value {{latestData.sugar > 7.0 ? 'warning' : 'normal'}}">
            {{latestData.sugar}} mmol/L
          </text>
        </view>
        <view class="data-item" wx:if="{{latestData.weight !== undefined}}">
          <text class="data-label">体重</text>
          <text class="data-value normal">
            {{latestData.weight}} kg
          </text>
        </view>
        <view class="data-time">
          <icon type="waiting" size="14" color="#999"></icon>
          <text class="time-text">测量时间：{{latestData.measure_time}}</text>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-text">暂无测量记录</text>
      </view>
    </view>
  </block>

  <block wx:if="{{role === 'family'}}">
    <view class="bind-section" bindtap="goToBindPatient">
      <view class="bind-card">
        <view class="bind-icon">
          <view class="icon-link"></view>
        </view>
        <view class="bind-content">
          <text class="bind-title">绑定患者</text>
          <text class="bind-desc">关联长辈，查看健康数据</text>
        </view>
        <text class="bind-arrow">></text>
      </view>
    </view>

    <view class="section" wx:if="{{patientList.length > 0}}">
      <text class="section-title">我关注的患者</text>
      <view class="patient-list">
        <view class="patient-card" wx:for="{{patientList}}" wx:key="_id" bindtap="viewPatientDetail" data-id="{{item.patientOpenid}}">
          <view class="patient-avatar">
            <text>{{item.patientName.substring(0,1)}}</text>
          </view>
          <view class="patient-info">
            <text class="patient-name">{{item.patientName}}</text>
            <text class="patient-relation">{{item.relation}}</text>
          </view>
          <view class="patient-status">
            <text class="status-dot"></text>
            <text class="status-text">已关联</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{patientList.length === 0 && !loading}}">
      <view class="empty-patient">
        <view class="empty-icon-wrapper">
          <view class="icon-person"></view>
        </view>
        <text class="empty-title">暂无关联患者</text>
        <text class="empty-desc">请先绑定患者，即可查看其健康数据</text>
      </view>
    </view>
  </block>
</view>
