<view class="container">
  <view class="header">
    <text class="title">我的申请</text>
    <text class="subtitle">查看绑定申请状态</text>
  </view>

  <view class="list" wx:if="{{requestList.length > 0}}">
    <view class="request-card" wx:for="{{requestList}}" wx:key="_id">
      <view class="request-header">
        <view class="patient-avatar">
          <text>{{item.patientName ? item.patientName.substring(0,1) : '?'}}</text>
        </view>
        <view class="patient-info">
          <text class="patient-name">{{item.patientName || '未知患者'}}</text>
          <text class="request-time">申请时间：{{item.createTimeStr}}</text>
        </view>
        <view class="status-tag {{item.status === 0 ? 'pending' : (item.status === 1 ? 'approved' : 'rejected')}}">
          <text>{{item.status === 0 ? '待审批' : (item.status === 1 ? '已通过' : '已拒绝')}}</text>
        </view>
      </view>
      <view class="request-body">
        <view class="info-item">
          <text class="label">亲属关系</text>
          <text class="value">{{item.relation}}</text>
        </view>
        <view class="info-item" wx:if="{{item.remark}}">
          <text class="label">备注信息</text>
          <text class="value">{{item.remark}}</text>
        </view>
      </view>
      <!-- 已拒绝时可重新申请 -->
      <view class="request-footer" wx:if="{{item.status === 2}}">
        <view class="btn-reapply" bindtap="onReapply" data-id="{{item.patientOpenid}}">
          <text>重新申请</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{requestList.length === 0 && !loading}}">
    <view class="empty-icon">
      <view class="empty-bell"></view>
    </view>
    <text class="empty-title">暂无申请记录</text>
    <text class="empty-desc">您可以在个人中心绑定患者</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
