/**app.wxss - 全局样式**/

/* 色彩变量定义 */
page {
  --primary-color: #07C160;
  --primary-light: #E8F5E9;
  --primary-dark: #06AD56;
  --bg-gradient-start: #E8F5E9;
  --bg-gradient-end: #F7F8FA;
  --card-bg: rgba(255, 255, 255, 0.9);
  --card-bg-solid: #FFFFFF;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --text-disabled: #BBBBBB;
  --border-color: rgba(0, 0, 0, 0.06);
  --warning-color: #E53935;
  --success-color: #07C160;
  
  background: linear-gradient(180deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 40%);
  background-attachment: fixed;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
  min-height: 100vh;
}

/* 容器 */
.container {
  padding: 30rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 全局卡片样式 - 玻璃拟态 */
.card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

/* 标题样式 */
.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* 重要数值样式 */
.value-highlight {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
  font-variant-numeric: tabular-nums;
}

.value-warning {
  color: var(--warning-color);
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-disabled);
}

/* 主按钮样式 */
.btn-primary {
  width: 100%;
  height: 100rpx;
  background: var(--primary-color);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.2s;
}

.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 12rpx 36rpx rgba(7, 193, 96, 0.4),
    0 4rpx 12rpx rgba(7, 193, 96, 0.2);
  z-index: 100;
  transition: all 0.2s;
}

.fab-btn:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}

/* 列表项卡片 - 玻璃拟态 */
.list-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  transition: transform 0.2s;
}

.list-card:active {
  transform: scale(0.98);
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tag-success {
  background: var(--primary-light);
  color: var(--primary-color);
}

.tag-warning {
  background: #FFEBEE;
  color: var(--warning-color);
}

/* 按钮重置 */
button {
  background: initial;
  padding: 0;
  margin: 0;
  line-height: normal;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 20rpx 0;
}

/* 玻璃卡片通用类 - 用于各页面卡片 */
.glass-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

/* 表单区域 - 玻璃拟态 */
.form-section {
  background: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

/* 卡片悬浮动画 */
@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-4rpx);
  }
}
